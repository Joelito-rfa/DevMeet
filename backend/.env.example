# Copiez ce fichier en `.env` puis adaptez les valeurs.
# `.env` ne doit jamais être versionné.

NODE_ENV=development

PORT=3000
CLIENT_URL=http://localhost:5173

# --- MySQL -------------------------------------------------------------------
# Démarrage du serveur (Laragon MySQL 8.4.3, non installé comme service) :
#   & 'C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysqld.exe' `
#     --datadir='C:\laragon\data\mysql' --port=3306 --bind-address=127.0.0.1 --console
#
# Création de la base et de l'utilisateur applicatif (une seule fois, en root) :
#   npm run db:create
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=devmeet_user
DB_PASSWORD=changez-moi
DB_NAME=devmeet_db
DB_CONNECTION_LIMIT=10

# --- Authentification --------------------------------------------------------
# Générer une valeur solide :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez-moi-par-une-valeur-aleatoire-de-64-caracteres-minimum
JWT_EXPIRES_IN=1h

# Limitation de débit sur les routes d'authentification.
# NODE_ENV=test la désactive automatiquement (utilisé par `npm test`).
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=30

# --- Pièces jointes ----------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Communauté technique qui héberge les salons historiques (code d'accès)
SYSTEM_COMMUNITY_ID=1
